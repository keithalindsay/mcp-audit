{
  "name": "mcp-audit",
  "version": "0.1.0",
  "description": "A security linter for MCP servers — connect, introspect, and flag the tool designs that turn an AI agent into an exfiltration or code-execution vector.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "linter",
    "audit",
    "ai",
    "agent",
    "lethal-trifecta"
  ],
  "author": "Keith Lindsay",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli.ts demo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.112.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
